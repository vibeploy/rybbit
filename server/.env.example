NODE_ENV=development

# ClickHouse configuration
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# PostgreSQL configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional Redis Sentinel discovery. When set, REDIS_HOST and REDIS_PORT are ignored.
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_MASTER_NAME=mymaster
REDIS_SENTINEL_USERNAME=
REDIS_SENTINEL_PASSWORD=

# Authentication
BETTER_AUTH_SECRET=your-secret-key-here

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AppSumo (optional - cloud only)
APPSUMO_CLIENT_ID=
APPSUMO_CLIENT_SECRET=

# Session replay object storage (optional, S3-compatible)
SESSION_REPLAY_S3_ENABLED=false
SESSION_REPLAY_S3_ENDPOINT=
SESSION_REPLAY_S3_REGION=auto
SESSION_REPLAY_S3_ACCESS_KEY_ID=
SESSION_REPLAY_S3_SECRET_ACCESS_KEY=
SESSION_REPLAY_S3_BUCKET=rybbit
SESSION_REPLAY_S3_FORCE_PATH_STYLE=true

# Legacy Cloudflare R2 configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
